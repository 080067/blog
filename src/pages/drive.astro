---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex,nofollow" />
		<link rel="icon" href="/images/favicon-rc-32.png" sizes="32x32" type="image/png" />
		<link rel="icon" href="/images/favicon-rc-180.png" sizes="180x180" type="image/png" />
		<title>我的网盘 · 39の寧靜之地</title>
	</head>
	<body class="drive-page" data-pagefind-ignore>
		<drive-app>
			<div class="d-splash">正在打开网盘…</div>
		</drive-app>
	</body>
</html>

<script>
	type DriveFile = {
		key: string;
		name: string;
		size: number;
		uploaded: string;
		type: string;
		kind: "image" | "audio" | "video" | "pdf" | "text" | "other";
		favorite: boolean;
		url: string;
		download: string;
	};

	type DriveFolder = { prefix: string; name: string };

	type ShareItem = {
		token: string;
		key: string;
		name: string;
		created: number;
		expires: number | null;
		expired: boolean;
		url: string;
	};

	type TrashItem = { id: string; key: string; name: string; size: number; uploaded: string; deletedAt: number };

	type UploadTask = { id: number; name: string; size: number; progress: number; status: string; failed?: boolean };

	type State = {
		authed: boolean | null;
		view: "files" | "favorites" | "trash" | "shares";
		prefix: string;
		folders: DriveFolder[];
		files: DriveFile[];
		q: string;
		sort: string;
		layout: "list" | "grid";
		selected: Set<string>;
		favorites: string[];
		shares: ShareItem[];
		trash: TrashItem[];
		usage: { total: number; count: number; limit: number };
		uploads: UploadTask[];
		busy: boolean;
		loading: boolean;
		/* 默认不显示勾选框；点「选择」才进入多选模式 */
		selectMode: boolean;
	};

	const fmtSize = (bytes: number) => {
		if (!bytes) return "0 B";
		if (bytes < 1024) return `${bytes} B`;
		if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
		if (bytes < 1024 * 1024 * 1024) return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
		return `${(bytes / 1024 / 1024 / 1024).toFixed(2)} GB`;
	};

	const fmtDate = (value: string | number) => {
		const date = new Date(value);
		if (Number.isNaN(date.getTime())) return "";
		const pad = (n: number) => String(n).padStart(2, "0");
		return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
	};

	const escapeHtml = (value: string) =>
		String(value).replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" } as Record<string, string>)[char]);

	const ICONS: Record<string, string> = {
		folder:
			'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h3.2c.7 0 1.35.33 1.77.9l.8 1.1H19a2 2 0 0 1 2 2v7.5A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5Z"/></svg>',
		image: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4.5" width="18" height="15" rx="2.5"/><circle cx="9" cy="10" r="1.6"/><path d="m4 17 4.5-4.5 3.5 3.5 3-3L20 17"/></svg>',
		audio: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 17V6l10-2v11"/><circle cx="6.5" cy="17.5" r="2.5"/><circle cx="16.5" cy="15.5" r="2.5"/></svg>',
		video: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m10 9 5 3-5 3Z"/></svg>',
		pdf: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3h7l5 5v13H6Z"/><path d="M13 3v5h5"/></svg>',
		text: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3h7l5 5v13H6Z"/><path d="M9 12h6M9 16h4"/></svg>',
		other: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3h7l5 5v13H6Z"/><path d="M13 3v5h5"/></svg>',
		star: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m12 4 2.4 5 5.6.7-4 3.9 1 5.4-5-2.7-5 2.7 1-5.4-4-3.9 5.6-.7Z"/></svg>',
		starOn: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 4 2.4 5 5.6.7-4 3.9 1 5.4-5-2.7-5 2.7 1-5.4-4-3.9 5.6-.7Z"/></svg>',
	};

	const iconFor = (file: { kind: string }) => ICONS[file.kind] || ICONS.other;

	/** 回收站里 .keep 占位文件代表一个文件夹，显示成目录名更直观 */
	const trashLabel = (item: { name: string; key: string }) => {
		if (item.name !== ".keep") return item.name;
		const path = item.key.replace(/\/\.keep$/, "");
		return path ? `${path}/（文件夹）` : "文件夹";
	};

	class DriveApp extends HTMLElement {
		state: State = {
			authed: null,
			view: "files",
			prefix: "",
			folders: [],
			files: [],
			q: "",
			sort: "name",
			layout: (localStorage.getItem("drive-layout") as "list" | "grid") || "list",
			selected: new Set(),
			favorites: [],
			shares: [],
			trash: [],
			usage: { total: 0, count: 0, limit: 0 },
			uploads: [],
			busy: false,
			loading: true,
			selectMode: false,
		};

		started = false;
		uploadSeq = 0;
		/* 上一次渲染列表的指纹：内容没变就不重播入场动画，避免「点一下整屏闪一下」 */
		lastFingerprint = "";

		async connectedCallback() {
			if (this.started) return;
			this.started = true;
			// 网盘是私有功能：接口不能被 CDN 缓存，所以固定回到源站域名。
			if (location.hostname === "cdn.nihilism.cloud") {
				location.replace("https://nihilism.cloud" + location.pathname + location.search);
				return;
			}
			this.innerHTML = `<div class="d-boot"><div class="d-spinner"></div><p>正在打开网盘…</p></div>`;
			await this.boot();
		}

		/** 载入中：顶栏进度条 + 内容区骨架屏（点击后立刻有反馈，不出现空白跳变） */
		setLoading(on: boolean) {
			this.state.loading = on;
			const layout = this.querySelector(".d-layout") as HTMLElement | null;
			if (layout) layout.classList.toggle("loading", on);
			const bar = this.querySelector("[data-progress]") as HTMLElement | null;
			if (bar) bar.classList.toggle("on", on);
			const body = this.querySelector("[data-body]") as HTMLElement | null;
			if (on && body) this.renderSkeleton(body);
		}

		renderSkeleton(body: HTMLElement) {
			const count = this.state.layout === "grid" ? 8 : 6;
			const item =
				this.state.layout === "grid"
					? `<div class="d-card d-skel"><div class="d-skel-thumb"></div><div class="d-skel-line w70"></div><div class="d-skel-line w40"></div></div>`
					: `<div class="d-row d-skel"><div class="d-skel-dot"></div><div class="d-skel-line w60"></div><div class="d-skel-line w20"></div><div class="d-skel-line w20"></div></div>`;
			body.className = this.state.layout === "grid" ? "d-body d-grid" : "d-body";
			body.innerHTML =
				this.state.layout === "grid"
					? Array.from({ length: count }, () => item).join("")
					: `<div class="d-list">${Array.from({ length: count }, () => item).join("")}</div>`;
		}

		async boot() {
			try {
				const res = await fetch("/api/drive/usage", { credentials: "same-origin" });
				if (res.status === 401) return this.renderAuth();
				this.state.authed = true;
				this.renderShell();
				await this.refresh();
			} catch {
				this.renderAuth("连不上网盘接口，检查网络后再试。");
			}
		}

		/* ---------------- 请求 ---------------- */

		async request(path: string, options: RequestInit = {}) {
			// 加一个时间戳参数，避免中间层（CDN）把列表/状态类接口缓存住导致「点文件夹没反应」。
			const method = (options.method || "GET").toUpperCase();
			const url = "/api/drive/" + path + (method === "GET" ? (path.includes("?") ? "&" : "?") + "_t=" + Date.now() : "");
			const res = await fetch(url, { credentials: "same-origin", ...options });
			if (res.status === 401) {
				this.state.authed = false;
				this.renderAuth();
				throw new Error("请先登录");
			}
			let data: any = {};
			try {
				data = await res.json();
			} catch {
				data = {};
			}
			if (!res.ok) throw new Error(data.error || `请求失败（${res.status}）`);
			return data;
		}

		async login(password: string) {
			const res = await fetch("/api/admin/login", {
				method: "POST",
				headers: { "content-type": "application/json" },
				credentials: "same-origin",
				body: JSON.stringify({ password }),
			});
			const data = await res.json().catch(() => ({}));
			if (!res.ok) throw new Error(data.error || "密码不正确");
		}

		/* ---------------- 数据 ---------------- */

		async refresh() {
			const { view } = this.state;
			/* 先把骨架屏推上去，再发请求：点一下立刻有反应，不会先空白再突然跳内容 */
			this.setLoading(true);
			await new Promise((resolve) => requestAnimationFrame(() => setTimeout(resolve, 90)));
			try {
				if (view === "files") await this.loadFiles();
				else if (view === "favorites") await this.loadFavorites();
				else if (view === "trash") await this.loadTrash();
				else if (view === "shares") await this.loadShares();
				await this.loadUsage();
			} catch (error) {
				if (this.state.authed === false) return;
				this.toast((error as Error).message, "error");
			}
			this.setLoading(false);
			this.render();
		}

		async loadFiles() {
			const params = new URLSearchParams();
			if (this.state.prefix) params.set("prefix", this.state.prefix);
			if (this.state.q) params.set("q", this.state.q);
			const data = await this.request(`list?${params.toString()}`);
			this.state.folders = this.state.q ? [] : (data.folders as DriveFolder[]);
			this.state.files = data.files as DriveFile[];
			this.state.selected.clear();
		}

		async loadFavorites() {
			const data = await this.request("favorites");
			this.state.folders = [];
			this.state.files = data.files as DriveFile[];
			this.state.selected.clear();
		}

		async loadTrash() {
			const data = await this.request("trash");
			this.state.trash = data.items as TrashItem[];
			this.state.selected.clear();
		}

		async loadShares() {
			const data = await this.request("meta");
			this.state.favorites = data.favorites as string[];
			this.state.shares = data.shares as ShareItem[];
			this.state.selected.clear();
		}

		async loadUsage() {
			const data = await this.request("usage");
			this.state.usage = data as { total: number; count: number; limit: number };
		}

		/* ---------------- 渲染：登录 ---------------- */

		renderAuth(message = "") {
			this.innerHTML = `
				<div class="d-auth">
					<div class="d-auth-card">
						<div class="d-auth-icon">🔒</div>
						<h1>私藏小仓库</h1>
						<p>这里存着我自己的歌和照片，用后台密码开门。</p>
						<form data-login>
							<input type="password" name="password" placeholder="输入密码" autocomplete="current-password" required />
							<button type="submit">进入</button>
						</form>
						${message ? `<p class="d-auth-error">${escapeHtml(message)}</p>` : ""}
						<p class="d-auth-foot"><a href="/">返回博客</a></p>
					</div>
				</div>`;
			const form = this.querySelector("form[data-login]") as HTMLFormElement;
			form?.addEventListener("submit", async (event) => {
				event.preventDefault();
				const input = form.querySelector("input") as HTMLInputElement;
				const button = form.querySelector("button") as HTMLButtonElement;
				button.disabled = true;
				button.textContent = "开门中…";
				try {
					await this.login(input.value);
					this.state.authed = true;
					await this.boot();
				} catch (error) {
					button.disabled = false;
					button.textContent = "进入";
					const tip = this.querySelector(".d-auth-error");
					if (tip) tip.textContent = (error as Error).message;
					else form.insertAdjacentHTML("afterend", `<p class="d-auth-error">${escapeHtml((error as Error).message)}</p>`);
				}
			});
		}

		/* ---------------- 渲染：骨架 ---------------- */

		renderShell() {
			this.innerHTML = `
				<div class="d-layout">
					<aside class="d-side">
						<a class="d-brand" href="/">
							<span class="d-brand-mark">✦</span>
							<span><strong>我的网盘</strong><small>SHILIN'S DRIVE</small></span>
						</a>
						<nav class="d-nav">
							<button data-nav="files">${ICONS.folder}<span>全部文件</span></button>
							<button data-nav="favorites">${ICONS.star}<span>收藏</span></button>
							<button data-nav="shares">${ICONS.other}<span>分享链接</span></button>
							<button data-nav="trash">${ICONS.text}<span>回收站</span></button>
						</nav>
						<div class="d-usage">
							<div class="d-usage-bar"><i data-usage-bar></i></div>
							<p data-usage-text>统计中…</p>
						</div>
						<a class="d-back" href="/">← 返回博客</a>
					</aside>
					<main class="d-main">
						<header class="d-top">
							<nav class="d-crumbs" data-crumbs></nav>
							<div class="d-top-actions">
								<label class="d-search">
									<input type="search" placeholder="搜索文件名…" data-search />
								</label>
								<button class="d-icon-btn" data-act="toggle-layout" title="切换视图" data-layout-btn></button>
								<select data-sort class="d-sort">
									<option value="name">按名称</option>
									<option value="date">按时间</option>
									<option value="size">按大小</option>
								</select>
								<button class="d-btn d-btn-primary" data-act="upload">＋ 上传</button>
							</div>
						</header>
						<div class="d-toolbar" data-toolbar></div>
						<div class="d-progress" data-progress><i></i></div>
						<section class="d-body" data-body></section>
						<div class="d-uploads" data-uploads></div>
					</main>
				</div>
				<input type="file" multiple hidden data-file-input />
				<div class="d-modal" data-modal hidden></div>
				<div class="d-toast" data-toast hidden></div>
				<div class="d-drop-hint" data-drop-hint>松手就上传到这里</div>`;

			this.bind();
			this.querySelectorAll<HTMLButtonElement>("[data-nav]").forEach((button) => {
				button.addEventListener("click", async () => {
					const view = button.dataset.nav as State["view"];
					if (this.state.view === view) return;
					this.state.view = view;
					this.state.q = "";
					(this.querySelector("[data-search]") as HTMLInputElement).value = "";
					/* 先把高亮切过去：用户点完立刻看到「我点的是这个」，再等数据回来 */
					this.renderSidebar();
					this.renderCrumbs();
					await this.refresh();
				});
			});

			const search = this.querySelector("[data-search]") as HTMLInputElement;
			let timer = 0;
			search.addEventListener("input", () => {
				window.clearTimeout(timer);
				timer = window.setTimeout(async () => {
					this.state.q = search.value.trim();
					this.state.prefix = this.state.q ? "" : this.state.prefix;
					await this.refresh();
				}, 220);
			});

			const sort = this.querySelector("[data-sort]") as HTMLSelectElement;
			sort.value = this.state.sort;
			sort.addEventListener("change", () => {
				this.state.sort = sort.value;
				this.render();
			});

			const input = this.querySelector("[data-file-input]") as HTMLInputElement;
			input.addEventListener("change", () => {
				const files = Array.from(input.files || []);
				input.value = "";
				if (files.length) this.enqueue(files.map((file) => ({ file, path: this.state.prefix + file.name })));
			});

			this.setupDragAndDrop();
		}

		bind() {
			this.addEventListener("click", (event) => {
				const target = event.target as HTMLElement;
				const actionEl = target.closest("[data-act]") as HTMLElement | null;
				if (!actionEl) {
					/* 选择模式下，点整行就是勾选/取消勾选 */
					if (this.state.selectMode) {
						const row = target.closest("[data-open]") as HTMLElement | null;
						if (!row) return;
						const key = row.dataset.open === "folder" ? `folder:${row.dataset.prefix || ""}` : row.dataset.key || "";
						if (!key) return;
						if (this.state.selected.has(key)) this.state.selected.delete(key);
						else this.state.selected.add(key);
						this.renderToolbar();
						this.renderBody();
					}
					return;
				}
				const act = actionEl.dataset.act;
				if (!act) return;
				event.preventDefault();
				void this.handleAction(act, actionEl, event);
			});

			this.addEventListener("dblclick", (event) => {
				const row = (event.target as HTMLElement).closest("[data-open]") as HTMLElement | null;
				if (!row) return;
				/* 选择模式下双击不跳转，避免误操作 */
				if (this.state.selectMode) return;
				const kind = row.dataset.open;
				if (kind === "folder") void this.openFolder(row.dataset.prefix || "");
				else if (kind === "file") void this.preview(row.dataset.key || "");
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					this.closeModal();
					if (this.state.selectMode) {
						this.state.selectMode = false;
						this.state.selected.clear();
						this.renderToolbar();
						this.renderBody();
					}
				}
				if ((event.key === "Delete" || event.key === "Backspace") && this.state.selected.size && !(event.target as HTMLElement).closest("input,textarea")) {
					event.preventDefault();
					void this.deleteSelected();
				}
				if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "a" && !(event.target as HTMLElement).closest("input,textarea")) {
					event.preventDefault();
					this.state.selectMode = true;
					for (const key of this.visibleKeys()) this.state.selected.add(key);
					this.renderToolbar();
					this.renderBody();
				}
			});
		}

		visibleKeys() {
			return [...this.state.folders.map((f) => `folder:${f.prefix}`), ...this.state.files.map((f) => f.key)];
		}

		/* ---------------- 交互 ---------------- */

		async handleAction(act: string, el: HTMLElement, event: Event) {
			const key = el.dataset.key || "";
			try {
				switch (act) {
					case "toggle-layout": {
						this.state.layout = this.state.layout === "list" ? "grid" : "list";
						localStorage.setItem("drive-layout", this.state.layout);
						this.render();
						return;
					}
					case "upload":
						(this.querySelector("[data-file-input]") as HTMLInputElement).click();
						return;
					case "mkdir": {
						const name = window.prompt("新建文件夹，名字：", "");
						if (!name) return;
						await this.request("mkdir", {
							method: "POST",
							headers: { "content-type": "application/json" },
							body: JSON.stringify({ prefix: this.state.prefix, name }),
						});
						this.toast("文件夹已创建");
						await this.refresh();
						return;
					}
					case "open-folder":
						await this.openFolder(el.dataset.prefix || "");
						return;
					case "crumb":
						this.state.prefix = el.dataset.prefix || "";
						this.state.q = "";
						(this.querySelector("[data-search]") as HTMLInputElement).value = "";
						this.state.view = "files";
						await this.refresh();
						return;
					case "enter-select": {
						event.stopPropagation();
						this.state.selectMode = true;
						if (key) this.state.selected.add(key);
						this.renderToolbar();
						this.renderBody();
						return;
					}
					case "exit-select": {
						event.stopPropagation();
						this.state.selectMode = false;
						this.state.selected.clear();
						this.renderToolbar();
						this.renderBody();
						return;
					}
					case "select-row": {
						if ((event as MouseEvent).detail > 1) return;
						event.stopPropagation();
						if (this.state.selected.has(key)) this.state.selected.delete(key);
						else this.state.selected.add(key);
						this.renderToolbar();
						this.renderBody();
						return;
					}
					case "select-all": {
						if (this.state.selected.size) this.state.selected.clear();
						else for (const k of this.visibleKeys()) this.state.selected.add(k);
						this.renderToolbar();
						this.renderBody();
						return;
					}
					case "preview":
						await this.preview(key);
						return;
					case "download":
						window.open(`/api/drive/file?key=${encodeURIComponent(key)}&download=1`, "_blank");
						return;
					case "favorite": {
						const on = !this.state.favorites.includes(key);
						await this.request("favorite", {
							method: "POST",
							headers: { "content-type": "application/json" },
							body: JSON.stringify({ key, on }),
						});
						this.state.favorites = on ? [...this.state.favorites, key] : this.state.favorites.filter((k) => k !== key);
						this.render();
						return;
					}
					case "share-file": {
						const link = await this.createShare([key]);
						if (link) this.openShareDialog(link);
						return;
					}
					case "rename": {
						const current = key.split("/").pop() || key;
						const name = window.prompt("新名字：", current);
						if (!name || name === current) return;
						await this.request("rename", {
							method: "POST",
							headers: { "content-type": "application/json" },
							body: JSON.stringify({ key, name }),
						});
						this.toast("已重命名");
						await this.refresh();
						return;
					}
					case "delete-file":
						await this.request(`delete?key=${encodeURIComponent(key)}`, { method: "DELETE" });
						this.toast("已移入回收站");
						await this.refresh();
						return;
					case "delete-folder": {
						const prefix = el.dataset.prefix || "";
						if (!window.confirm(`把「${prefix.replace(/\/$/, "").split("/").pop()}」整个文件夹移到回收站？`)) return;
						const data = await this.request("delete-folder", {
							method: "POST",
							headers: { "content-type": "application/json" },
							body: JSON.stringify({ prefix }),
						});
						this.toast(`已移入回收站（${data.moved} 个文件）`);
						await this.refresh();
						return;
					}
					case "bulk-delete":
						await this.deleteSelected();
						return;
					case "bulk-fav":
						await this.favoriteSelected();
						return;
					case "bulk-share": {
						const keys = [...this.state.selected].filter((k) => !k.startsWith("folder:"));
						if (!keys.length) return this.toast("分享只支持单个文件", "error");
						const link = await this.createShare(keys);
						if (link) this.openShareDialog(link);
						return;
					}
					case "bulk-move":
						await this.moveSelected();
						return;
					case "restore": {
						await this.request("restore", {
							method: "POST",
							headers: { "content-type": "application/json" },
							body: JSON.stringify({ id: el.dataset.id }),
						});
						this.toast("已还原");
						await this.refresh();
						return;
					}
					case "purge": {
						if (!window.confirm("彻底删除这个文件？无法恢复。")) return;
						await this.request("purge", {
							method: "POST",
							headers: { "content-type": "application/json" },
							body: JSON.stringify({ id: el.dataset.id }),
						});
						this.toast("已彻底删除");
						await this.refresh();
						return;
					}
					case "empty-trash": {
						if (!window.confirm("清空回收站？里面的文件会彻底删除。")) return;
						const data = await this.request("empty-trash", { method: "POST" });
						this.toast(`回收站已清空（${data.removed} 个）`);
						await this.refresh();
						return;
					}
					case "copy-link": {
						const url = new URL(el.dataset.url || "", location.origin).toString();
						await navigator.clipboard.writeText(url).catch(() => {});
						this.toast("链接已复制");
						return;
					}
					case "revoke": {
						await this.request("unshare", {
							method: "POST",
							headers: { "content-type": "application/json" },
							body: JSON.stringify({ token: el.dataset.token }),
						});
						this.toast("已取消分享");
						await this.refresh();
						return;
					}
					case "logout":
						await fetch("/api/admin/logout", { method: "POST", credentials: "same-origin" });
						this.state.authed = false;
						this.renderAuth();
						return;
				}
			} catch (error) {
				if (this.state.authed === false) return;
				this.toast((error as Error).message, "error");
			}
		}

		async openFolder(prefix: string) {
			this.state.view = "files";
			this.state.prefix = prefix;
			this.state.q = "";
			(this.querySelector("[data-search]") as HTMLInputElement).value = "";
			await this.refresh();
		}

		async createShare(keys: string[]) {
			if (keys.length !== 1) {
				this.toast("一次只能分享一个文件", "error");
				return "";
			}
			const data = await this.request("share", {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({ key: keys[0] }),
			});
			await this.loadShares();
			return new URL(data.url, location.origin).toString();
		}

		/* 批量操作结束后退出选择模式，回到干净的浏览状态 */
		endSelection() {
			this.state.selectMode = false;
			this.state.selected.clear();
		}

		async favoriteSelected() {
			for (const key of this.state.selected) {
				if (key.startsWith("folder:")) continue;
				const on = !this.state.favorites.includes(key);
				await this.request("favorite", {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ key, on }),
				});
			}
			this.toast("已更新收藏");
			this.endSelection();
			await this.refresh();
		}

		async deleteSelected() {
			const keys = [...this.state.selected];
			if (!keys.length) return;
			if (!window.confirm(`把选中的 ${keys.length} 项移入回收站？`)) return;
			for (const key of keys) {
				if (key.startsWith("folder:")) {
					await this.request("delete-folder", {
						method: "POST",
						headers: { "content-type": "application/json" },
						body: JSON.stringify({ prefix: key.slice(7) }),
					});
				} else {
					await this.request(`delete?key=${encodeURIComponent(key)}`, { method: "DELETE" });
				}
			}
			this.toast("已移入回收站");
			this.endSelection();
			await this.refresh();
		}

		async moveSelected() {
			const keys = [...this.state.selected].filter((k) => !k.startsWith("folder:"));
			if (!keys.length) return this.toast("文件夹暂不支持移动", "error");
			const target = window.prompt("移动到哪个文件夹？（留空 = 根目录，用 / 分隔层级）", this.state.prefix);
			if (target === null) return;
			const clean = target.trim().replace(/^\/+|\/+$/g, "");
			for (const key of keys) {
				const name = key.split("/").pop() || key;
				await this.request("move", {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ from: key, to: clean ? `${clean}/${name}` : name }),
				});
			}
			this.toast("已移动");
			this.endSelection();
			await this.refresh();
		}

		/* ---------------- 预览 ---------------- */

		async preview(key: string) {
			const file = this.state.files.find((item) => item.key === key);
			if (!file) return;
			const url = `/api/drive/file?key=${encodeURIComponent(key)}`;
			let body = "";
			if (file.kind === "image") body = `<img src="${url}" alt="" />`;
			else if (file.kind === "video") body = `<video src="${url}" controls autoplay></video>`;
			else if (file.kind === "audio") body = `<div class="d-audio"><div class="d-audio-icon">♪</div><audio src="${url}" controls autoplay></audio></div>`;
			else if (file.kind === "pdf") body = `<iframe src="${url}" title="PDF"></iframe>`;
			else if (file.kind === "text") {
				const res = await fetch(url, { credentials: "same-origin" });
				const text = await res.text();
				body = `<pre class="d-text">${escapeHtml(text.slice(0, 200000))}</pre>`;
			} else {
				body = `<div class="d-no-preview"><p>这种格式没法在线预览</p><a class="d-btn d-btn-primary" href="${url}&download=1">下载文件</a></div>`;
			}
			this.openModal(`
				<div class="d-modal-head">
					<strong>${escapeHtml(file.name)}</strong>
					<div>
						<a class="d-btn" href="${url}&download=1">下载</a>
						<button class="d-icon-btn" data-act="close-modal">✕</button>
					</div>
				</div>
				<div class="d-modal-body">${body}</div>`);
		}

		openModal(html: string) {
			const modal = this.querySelector("[data-modal]") as HTMLElement;
			modal.innerHTML = html;
			modal.hidden = false;
			modal.classList.add("open");
			modal.onclick = (event) => {
				if (event.target === modal || (event.target as HTMLElement).closest("[data-act='close-modal']")) this.closeModal();
			};
		}

		closeModal() {
			const modal = this.querySelector("[data-modal]") as HTMLElement | null;
			if (!modal) return;
			modal.hidden = true;
			modal.classList.remove("open");
			modal.innerHTML = "";
			modal.querySelectorAll("video,audio").forEach((el) => (el as HTMLMediaElement).pause());
		}

		openShareDialog(url: string) {
			this.openModal(`
				<div class="d-modal-head">
					<strong>分享链接</strong>
					<button class="d-icon-btn" data-act="close-modal">✕</button>
				</div>
				<div class="d-modal-body d-share-body">
					<p>拿到这个链接的人都能直接访问（知道链接即可，不会出现在任何列表里）：</p>
					<input class="d-share-input" readonly value="${escapeHtml(url)}" />
					<div class="d-share-actions">
						<button class="d-btn d-btn-primary" data-act="copy-link" data-url="${escapeHtml(url)}">复制链接</button>
						<a class="d-btn" href="${escapeHtml(url)}" target="_blank">打开看看</a>
					</div>
				</div>`);
		}

		/* ---------------- 上传 ---------------- */

		setupDragAndDrop() {
			const zone = this.querySelector("[data-body]") as HTMLElement;
			const hint = this.querySelector("[data-drop-hint]") as HTMLElement;
			const show = (on: boolean) => hint.classList.toggle("show", on);
			let depth = 0;
			["dragenter", "dragover"].forEach((type) =>
				zone.addEventListener(type, (event) => {
					event.preventDefault();
					depth += 1;
					show(true);
				}),
			);
			["dragleave", "dragend"].forEach((type) =>
				zone.addEventListener(type, () => {
					depth = Math.max(0, depth - 1);
					if (!depth) show(false);
				}),
			);
			zone.addEventListener("drop", async (event) => {
				event.preventDefault();
				depth = 0;
				show(false);
				const transfer = (event as DragEvent).dataTransfer;
				if (!transfer) return;
				const entries: { file: File; path: string }[] = [];
				const items = Array.from(transfer.items || []);
				const readEntry = async (entry: any, base: string): Promise<void> => {
					if (entry.isFile) {
						const file = await new Promise<File>((resolve, reject) => entry.file(resolve, reject));
						entries.push({ file, path: base + file.name });
					} else if (entry.isDirectory) {
						const reader = entry.createReader();
						const children: any[] = await new Promise((resolve) => {
							const all: any[] = [];
							const read = () => reader.readEntries((batch: any[]) => (batch.length ? (all.push(...batch), read()) : resolve(all)), () => resolve(all));
							read();
						});
						for (const child of children) await readEntry(child, base + entry.name + "/");
					}
				};
				if (items.length && (items[0] as any).webkitGetAsEntry) {
					for (const item of items) {
						const entry = (item as any).webkitGetAsEntry();
						if (entry) await readEntry(entry, this.state.prefix);
					}
				}
				if (!entries.length) {
					for (const file of Array.from(transfer.files || [])) entries.push({ file, path: this.state.prefix + file.name });
				}
				if (entries.length) void this.enqueue(entries);
			});
		}

		enqueue(items: { file: File; path: string }[]) {
			const tasks = items.map((item) => {
				const task: UploadTask = { id: ++this.uploadSeq, name: item.path, size: item.file.size, progress: 0, status: "排队中" };
				this.state.uploads.push(task);
				return { item, task };
			});
			this.renderUploads();
			void this.runUploads(tasks);
		}

		async runUploads(tasks: { item: { file: File; path: string }; task: UploadTask }[]) {
			/* 三条一起传：单条 TCP 在上行差的线路上跑不满，并发能明显快一截 */
			const CONCURRENCY = 3;
			let cursor = 0;
			const worker = async () => {
				while (cursor < tasks.length) {
					const { item, task } = tasks[cursor++];
					try {
						task.status = "上传中";
						this.renderUploads();
						if (item.file.size > 40 * 1024 * 1024) await this.uploadMultipart(item.file, item.path, task);
						else await this.uploadSmall(item.file, item.path, task);
						task.progress = 100;
						task.status = "完成";
						/* 图片顺手传一张缩略图，之后网格不用再拉原图 */
						void this.makeThumb(item.file, item.path);
					} catch (error) {
						task.status = `失败：${(error as Error).message}`;
						task.failed = true;
					}
					this.renderUploads();
				}
			};
			await Promise.all(Array.from({ length: Math.min(CONCURRENCY, tasks.length) }, worker));
			await this.refresh();
			window.setTimeout(() => {
				this.state.uploads = this.state.uploads.filter((task) => task.status === "上传中" || task.status === "排队中" || task.failed);
				this.renderUploads();
			}, 4000);
		}

		/** 浏览器里把图片压成 480px 的 webp，作为网格缩略图 */
		async makeThumb(file: File, key: string) {
			if (!file.type.startsWith("image/")) return;
			if (file.type === "image/svg+xml" || file.type === "image/gif") return;
			if (file.size < 40 * 1024) return; // 本来就不大，不用缩略图
			try {
				const bitmap = await createImageBitmap(file);
				const scale = Math.min(1, 480 / Math.max(bitmap.width, bitmap.height));
				const width = Math.max(1, Math.round(bitmap.width * scale));
				const height = Math.max(1, Math.round(bitmap.height * scale));
				const canvas = document.createElement("canvas");
				canvas.width = width;
				canvas.height = height;
				const ctx = canvas.getContext("2d");
				if (!ctx) return;
				ctx.imageSmoothingQuality = "high";
				ctx.drawImage(bitmap, 0, 0, width, height);
				bitmap.close?.();
				const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/webp", 0.8));
				if (!blob) return;
				await fetch(`/api/drive/thumb?key=${encodeURIComponent(key)}`, {
					method: "POST",
					credentials: "same-origin",
					headers: { "content-type": "image/webp" },
					body: blob,
				});
			} catch {
				/* 缩略图是锦上添花，失败了不影响原图 */
			}
		}

		uploadSmall(file: File, key: string, task: UploadTask) {
			return new Promise<void>((resolve, reject) => {
				const xhr = new XMLHttpRequest();
				xhr.open("POST", `/api/drive/upload?key=${encodeURIComponent(key)}`);
				xhr.setRequestHeader("content-type", file.type || "application/octet-stream");
				xhr.withCredentials = true;
				xhr.upload.onprogress = (event) => {
					if (!event.lengthComputable) return;
					task.progress = Math.round((event.loaded / event.total) * 100);
					this.renderUploads();
				};
				xhr.onload = () => {
					if (xhr.status >= 200 && xhr.status < 300) return resolve();
					let message = `上传失败（${xhr.status}）`;
					try {
						message = JSON.parse(xhr.responseText).error || message;
					} catch {
						/* 忽略 */
					}
					reject(new Error(message));
				};
				xhr.onerror = () => reject(new Error("网络中断"));
				xhr.send(file);
			});
		}

		async uploadMultipart(file: File, key: string, task: UploadTask) {
			const CHUNK = 8 * 1024 * 1024;
			const init = await this.request(`mp-init?key=${encodeURIComponent(key)}`, {
				method: "POST",
				headers: { "content-type": file.type || "application/octet-stream" },
			});
			const uploadId = init.uploadId as string;
			const total = Math.ceil(file.size / CHUNK);
			const parts: { partNumber: number; etag: string }[] = [];
			try {
				/* 分片并发：上行差的时候顺序传很吃窗口，三片一起跑通常能快一倍 */
				const PART_CONCURRENCY = 3;
				let done = 0;
				let next = 0;
				const worker = async () => {
					while (next < total) {
						const index = next++;
						const chunk = file.slice(index * CHUNK, Math.min((index + 1) * CHUNK, file.size));
						const res = await fetch(`/api/drive/mp-part?key=${encodeURIComponent(key)}&id=${encodeURIComponent(uploadId)}&n=${index + 1}`, {
							method: "POST",
							body: chunk,
							credentials: "same-origin",
						});
						if (!res.ok) {
							const data = await res.json().catch(() => ({}));
							throw new Error(data.error || `第 ${index + 1} 片上传失败`);
						}
						const data = await res.json();
						parts.push({ partNumber: data.partNumber, etag: data.etag });
						done += 1;
						task.progress = Math.round((done / total) * 98);
						this.renderUploads();
					}
				};
				await Promise.all(Array.from({ length: Math.min(PART_CONCURRENCY, total) }, worker));
				parts.sort((a, b) => a.partNumber - b.partNumber);
				await this.request(`mp-done?key=${encodeURIComponent(key)}&id=${encodeURIComponent(uploadId)}`, {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ parts }),
				});
			} catch (error) {
				await fetch(`/api/drive/mp-abort?key=${encodeURIComponent(key)}&id=${encodeURIComponent(uploadId)}`, {
					method: "POST",
					credentials: "same-origin",
				}).catch(() => {});
				throw error;
			}
		}

		/* ---------------- 渲染 ---------------- */

		render() {
			if (!this.querySelector(".d-layout")) return;
			this.renderSidebar();
			this.renderCrumbs();
			this.renderToolbar();
			this.renderBody();
			this.renderUsage();
			this.renderUploads();
			this.applyMotion();
		}

		/**
		 * 列表逐项浮入：给每项一个 --i 做 stagger。
		 * 内容没变就加 .no-anim，避免「收藏一下整屏重播动画」。
		 */
		applyMotion() {
			const body = this.querySelector("[data-body]") as HTMLElement | null;
			if (!body) return;
			const fingerprint = [
				this.state.view,
				this.state.prefix,
				this.state.q,
				this.state.layout,
				this.state.folders.map((f) => f.prefix).join(","),
				this.state.files.map((f) => f.key).join(","),
				this.state.trash.map((t) => t.id).join(","),
				this.state.shares.map((s) => s.token).join(","),
			].join("|");
			const replay = fingerprint !== this.lastFingerprint;
			this.lastFingerprint = fingerprint;
			body.classList.toggle("no-anim", !replay);
			if (!replay) return;
			const items = body.querySelectorAll<HTMLElement>(".d-list > *, .d-body.d-grid > *");
			items.forEach((el, index) => el.style.setProperty("--i", String(Math.min(index, 14))));
		}

		renderSidebar() {
			this.querySelectorAll<HTMLElement>("[data-nav]").forEach((button) => {
				button.classList.toggle("active", button.dataset.nav === this.state.view);
			});
			const layoutBtn = this.querySelector("[data-layout-btn]") as HTMLElement;
			if (layoutBtn) layoutBtn.textContent = this.state.layout === "list" ? "▦" : "☰";
			const toolbarExtra = this.querySelector("[data-mkdir]");
			if (!toolbarExtra && this.state.view === "files") {
				const actions = this.querySelector(".d-top-actions") as HTMLElement;
				const mkdir = document.createElement("button");
				mkdir.className = "d-btn";
				mkdir.dataset.act = "mkdir";
				mkdir.dataset.mkdir = "1";
				mkdir.textContent = "＋ 文件夹";
				actions?.insertBefore(mkdir, this.querySelector("[data-act='upload']"));
			}
		}

		renderCrumbs() {
			const crumbs = this.querySelector("[data-crumbs]") as HTMLElement;
			const parts = this.state.prefix.split("/").filter(Boolean);
			const items = [`<button data-act="crumb" data-prefix="">全部文件</button>`];
			let path = "";
			for (const part of parts) {
				path += part + "/";
				items.push(`<span class="d-crumb-sep">/</span><button data-act="crumb" data-prefix="${escapeHtml(path)}">${escapeHtml(part)}</button>`);
			}
			crumbs.innerHTML = this.state.view === "files" ? items.join("") : `<span class="d-crumb-title">${{ favorites: "收藏", trash: "回收站", shares: "分享链接" }[this.state.view]}</span>`;
		}

		renderToolbar() {
			const bar = this.querySelector("[data-toolbar]") as HTMLElement;
			if (this.state.view === "trash") {
				bar.innerHTML = this.state.trash.length
					? `<span class="d-tool-text">回收站里的文件可以还原，或彻底删除。</span><button class="d-btn d-btn-danger" data-act="empty-trash">清空回收站</button>`
					: "";
				return;
			}
			if (this.state.view === "shares") {
				bar.innerHTML = this.state.shares.length ? `<span class="d-tool-text">共 ${this.state.shares.length} 个分享链接</span>` : "";
				return;
			}
			const count = this.state.selected.size;
			if (!this.state.selectMode) {
				bar.innerHTML = `<span class="d-tool-text">${this.state.q ? `搜索「${escapeHtml(this.state.q)}」` : `${this.state.folders.length} 个文件夹 · ${this.state.files.length} 个文件`}</span>
					<button class="d-pick" data-act="enter-select">选择</button>`;
				return;
			}
			if (!count) {
				bar.innerHTML = `<label class="d-check-all"><input type="checkbox" data-act="select-all" /> <span>全选</span></label>
					<span class="d-tool-text">已进入选择模式 · 点一行来勾选</span>
					<button class="d-btn" data-act="exit-select">完成</button>`;
				return;
			}
			bar.innerHTML = `<label class="d-check-all"><input type="checkbox" data-act="select-all" ${this.state.files.length + this.state.folders.length === count ? "checked" : ""} /> <span>全选</span></label>
				<strong>已选 ${count} 项</strong>
				<div class="d-bulk">
					<button class="d-btn" data-act="bulk-move">移动</button>
					<button class="d-btn" data-act="bulk-fav">收藏</button>
					<button class="d-btn" data-act="bulk-share">分享</button>
					<button class="d-btn d-btn-danger" data-act="bulk-delete">删除</button>
					<button class="d-btn" data-act="exit-select">完成</button>
				</div>`;
		}

		sortedFiles() {
			const files = [...this.state.files];
			const dir = this.state.sort === "size" ? -1 : 1;
			files.sort((a, b) => {
				if (this.state.sort === "size") return (a.size - b.size) * dir;
				if (this.state.sort === "date") return (Date.parse(b.uploaded) - Date.parse(a.uploaded));
				return a.name.localeCompare(b.name, "zh-Hans-CN");
			});
			return files;
		}

		renderBody() {
			const body = this.querySelector("[data-body]") as HTMLElement;
			if (!body) return;
			if (this.state.view === "trash") {
				body.className = "d-body";
				body.innerHTML = this.state.trash.length
					? `<div class="d-list">${this.state.trash
							.map(
								(item) => `<div class="d-row">
						<div class="d-ico ${item.name === ".keep" ? "d-ico-folder" : ""}">${item.name === ".keep" ? ICONS.folder : ICONS.other}</div>
						<div class="d-name" title="${escapeHtml(item.key)}">${escapeHtml(trashLabel(item))}<small>${escapeHtml(item.key)}</small></div>
						<div class="d-meta">${item.name === ".keep" ? "文件夹" : fmtSize(item.size)}</div>
						<div class="d-meta">${fmtDate(item.deletedAt)} 删除</div>
						<div class="d-row-actions">
							<button class="d-icon-btn" data-act="restore" data-id="${item.id}" title="还原">↩</button>
							<button class="d-icon-btn" data-act="purge" data-id="${item.id}" title="彻底删除">🗑</button>
						</div>
					</div>`,
							)
							.join("")}</div>`
					: `<div class="d-empty">${ICONS.text}<p>回收站是空的</p></div>`;
				return;
			}
			if (this.state.view === "shares") {
				body.className = "d-body";
				body.innerHTML = this.state.shares.length
					? `<div class="d-list">${this.state.shares
							.map(
								(item) => `<div class="d-row">
						<div class="d-ico">${ICONS.other}</div>
						<div class="d-name">${escapeHtml(item.name)}<small>/s/${item.token}</small></div>
						<div class="d-meta">${fmtDate(item.created)}</div>
						<div class="d-meta">${item.expires ? (item.expired ? "已过期" : "到期 " + fmtDate(item.expires)) : "永久"}</div>
						<div class="d-row-actions">
							<button class="d-btn d-btn-sm" data-act="copy-link" data-url="${escapeHtml(item.url)}">复制</button>
							<button class="d-icon-btn" data-act="revoke" data-token="${item.token}" title="取消分享">✕</button>
						</div>
					</div>`,
							)
							.join("")}</div>`
					: `<div class="d-empty">${ICONS.other}<p>还没有分享链接</p><p class="d-empty-sub">在文件上点「分享」就能生成一条公开链接</p></div>`;
				return;
			}

			const folders = this.state.q ? [] : this.state.folders;
			const files = this.sortedFiles();
			if (!folders.length && !files.length) {
				body.className = "d-body";
				body.innerHTML = `<div class="d-empty">${ICONS.folder}<p>${this.state.q ? "没找到匹配的文件" : "这里还是空的，拖文件进来吧"}</p></div>`;
				this.updateSelectAll();
				return;
			}

			if (this.state.layout === "grid") {
				body.className = "d-body d-grid";
				body.innerHTML = [
					...folders.map(
						(folder) => `<div class="d-card d-card-folder${this.state.selectMode ? " pickable" : ""}${this.state.selected.has("folder:" + folder.prefix) ? " selected" : ""}" data-open="folder" data-prefix="${escapeHtml(folder.prefix)}"${this.state.selectMode ? ` data-act="select-row" data-key="folder:${escapeHtml(folder.prefix)}"` : ""}>
							${this.state.selectMode ? `<label class="d-check"><input type="checkbox" data-act="select-row" data-key="folder:${escapeHtml(folder.prefix)}" ${this.state.selected.has("folder:" + folder.prefix) ? "checked" : ""} /></label>` : ""}
							<div class="d-card-thumb">${ICONS.folder}</div>
							<div class="d-card-name">${escapeHtml(folder.name)}</div>
							${this.state.selectMode ? "" : `<button class="d-pick" data-act="enter-select" data-key="folder:${escapeHtml(folder.prefix)}">选择</button>`}
						</div>`,
					),
					...files.map((file) => this.cardHtml(file)),
				].join("");
			} else {
				body.className = "d-body";
				body.innerHTML = `<div class="d-list">${[
					...folders.map(
						(folder) => `<div class="d-row d-row-folder${this.state.selectMode ? " pickable" : ""}" data-open="folder" data-prefix="${escapeHtml(folder.prefix)}">
							${this.state.selectMode ? `<label class="d-check"><input type="checkbox" data-act="select-row" data-key="folder:${escapeHtml(folder.prefix)}" ${this.state.selected.has("folder:" + folder.prefix) ? "checked" : ""} /></label>` : ""}
							<div class="d-ico d-ico-folder">${ICONS.folder}</div>
							<div class="d-name">${escapeHtml(folder.name)}</div>
							<div class="d-meta">文件夹</div>
							<div class="d-meta"></div>
							<div class="d-row-actions">
								${this.state.selectMode ? "" : `<button class="d-pick" data-act="enter-select" data-key="folder:${escapeHtml(folder.prefix)}">选择</button>`}
								<button class="d-icon-btn" data-act="delete-folder" data-prefix="${escapeHtml(folder.prefix)}" title="删除文件夹">🗑</button>
							</div>
						</div>`,
					),
					...files.map((file) => this.rowHtml(file)),
				].join("")}</div>`;
			}
			this.updateSelectAll();
		}

		rowHtml(file: DriveFile) {
			const fav = this.state.favorites.includes(file.key);
			return `<div class="d-row${this.state.selectMode ? " pickable" : ""}${this.state.selected.has(file.key) ? " selected" : ""}" data-open="file" data-key="${escapeHtml(file.key)}">
				${this.state.selectMode ? `<label class="d-check"><input type="checkbox" data-act="select-row" data-key="${escapeHtml(file.key)}" ${this.state.selected.has(file.key) ? "checked" : ""} /></label>` : ""}
				<div class="d-ico d-ico-${file.kind}">${iconFor(file)}</div>
				<div class="d-name">${escapeHtml(file.name)}${fav ? ' <span class="d-fav">★</span>' : ""}</div>
				<div class="d-meta">${fmtSize(file.size)}</div>
				<div class="d-meta">${fmtDate(file.uploaded)}</div>
				<div class="d-row-actions">
					${this.state.selectMode ? "" : `<button class="d-pick" data-act="enter-select" data-key="${escapeHtml(file.key)}">选择</button>`}
					<button class="d-icon-btn" data-act="preview" data-key="${escapeHtml(file.key)}" title="预览">👁</button>
					<button class="d-icon-btn" data-act="download" data-key="${escapeHtml(file.key)}" title="下载">⤓</button>
					<button class="d-icon-btn ${fav ? "on" : ""}" data-act="favorite" data-key="${escapeHtml(file.key)}" title="收藏">${fav ? "★" : "☆"}</button>
					<button class="d-icon-btn" data-act="share-file" data-key="${escapeHtml(file.key)}" title="分享">🔗</button>
					<button class="d-icon-btn" data-act="rename" data-key="${escapeHtml(file.key)}" title="重命名">✎</button>
					<button class="d-icon-btn" data-act="delete-file" data-key="${escapeHtml(file.key)}" title="删除">🗑</button>
				</div>
			</div>`;
		}

		cardHtml(file: DriveFile) {
			const src = file.kind === "image" ? `/api/drive/thumb?key=${encodeURIComponent(file.key)}` : "";
			return `<div class="d-card ${this.state.selected.has(file.key) ? "selected" : ""}${this.state.selectMode ? " pickable" : ""}" data-open="file" data-key="${escapeHtml(file.key)}">
				${this.state.selectMode ? `<label class="d-check"><input type="checkbox" data-act="select-row" data-key="${escapeHtml(file.key)}" ${this.state.selected.has(file.key) ? "checked" : ""} /></label>` : ""}
				<div class="d-card-thumb">${src ? `<img src="${src}" loading="lazy" decoding="async" alt="" />` : iconFor(file)}</div>
				<div class="d-card-name">${escapeHtml(file.name)}</div>
				<div class="d-card-meta">${fmtSize(file.size)}</div>
				${this.state.selectMode ? "" : `<button class="d-pick" data-act="enter-select" data-key="${escapeHtml(file.key)}">选择</button>`}
				<div class="d-card-actions">
					<button class="d-icon-btn" data-act="download" data-key="${escapeHtml(file.key)}" title="下载">⤓</button>
					<button class="d-icon-btn" data-act="delete-file" data-key="${escapeHtml(file.key)}" title="删除">🗑</button>
				</div>
			</div>`;
		}

		updateSelectAll() {
			const all = this.querySelector("[data-act='select-all']") as HTMLInputElement | null;
			if (!all || all.type !== "checkbox") return;
			const total = this.state.files.length + this.state.folders.length;
			all.checked = total > 0 && this.state.selected.size >= total;
		}

		renderUsage() {
			const bar = this.querySelector("[data-usage-bar]") as HTMLElement;
			const text = this.querySelector("[data-usage-text]") as HTMLElement;
			if (!bar || !text) return;
			const { total, count, limit } = this.state.usage;
			const percent = limit ? Math.min(100, (total / limit) * 100) : 0;
			bar.style.width = `${percent.toFixed(2)}%`;
			bar.classList.toggle("warn", percent > 85);
			text.innerHTML = `${fmtSize(total)} / ${fmtSize(limit || 200 * 1024 ** 3)}<br /><span>${count} 个文件</span>`;
		}

		renderUploads() {
			const zone = this.querySelector("[data-uploads]") as HTMLElement;
			if (!zone) return;
			if (!this.state.uploads.length) {
				zone.innerHTML = "";
				zone.classList.remove("show");
				return;
			}
			zone.classList.add("show");
			zone.innerHTML = `<div class="d-upload-list">${this.state.uploads
				.map(
					(task) => `<div class="d-upload ${task.failed ? "failed" : ""}">
					<div class="d-upload-name" title="${escapeHtml(task.name)}">${escapeHtml(task.name)}</div>
					<div class="d-upload-bar"><i style="width:${task.progress}%"></i></div>
					<div class="d-upload-status">${escapeHtml(task.status)}${task.status === "上传中" ? ` ${task.progress}%` : ""}</div>
				</div>`,
				)
				.join("")}</div>`;
		}

		toast(message: string, kind: "info" | "error" = "info") {
			const toast = this.querySelector("[data-toast]") as HTMLElement;
			if (!toast) return;
			toast.textContent = message;
			toast.className = `d-toast show ${kind}`;
			window.clearTimeout((this as any).toastTimer);
			(this as any).toastTimer = window.setTimeout(() => toast.classList.remove("show"), 2600);
		}
	}

	if (!customElements.get("drive-app")) customElements.define("drive-app", DriveApp);
</script>

<style is:global>
	:root {
		--d-ink: #2c2a33;
		--d-muted: #6f6a7d;
		--d-line: rgb(120 96 160 / 0.16);
		--d-card: rgb(255 255 255 / 0.58);
		--d-accent: #9a7bd4;
		--d-accent-2: #f19bc4;
		--d-danger: #d9636f;
	}

	* { box-sizing: border-box; }

	/* 整页插画背景：透明蒙版压一层，内容浮在上面（参考图二那种通透感） */
	body.drive-page {
		margin: 0;
		min-height: 100dvh;
		font-family: "Roboto", system-ui, -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
		color: var(--d-ink);
		background-color: #efe9f6;
		background-image:
			linear-gradient(180deg, rgb(255 255 255 / 0.22) 0%, rgb(255 252 255 / 0.10) 40%, rgb(252 250 255 / 0.24) 100%),
			url("/images/drive-bg.jpg");
		background-size: cover, cover;
		background-position: center center, 64% 38%;
		background-repeat: no-repeat, no-repeat;
		background-attachment: fixed, fixed;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--d-ink: #ece9f4;
			--d-muted: #a8a2ba;
			--d-line: rgb(180 160 220 / 0.18);
			--d-card: rgb(28 24 38 / 0.56);
		}
		body.drive-page {
			background-color: #17131f;
			background-image:
				linear-gradient(180deg, rgb(20 16 28 / 0.5) 0%, rgb(20 16 28 / 0.38) 40%, rgb(20 16 28 / 0.56) 100%),
				url("/images/drive-bg-dark.jpg");
		}
	}

	.d-splash { padding: 4rem; text-align: center; color: var(--d-muted); }

	.d-layout {
		display: grid;
		grid-template-columns: 15.5rem minmax(0, 1fr);
		gap: 1.25rem;
		max-width: 84rem;
		margin: 0 auto;
		padding: 1.25rem;
		min-height: 100dvh;
	}

	/* 侧栏 */
	.d-side {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.15rem;
		border-radius: 1.4rem;
		background: var(--d-card);
		border: 1px solid var(--d-line);
		box-shadow: 0 1.2rem 3rem rgb(90 70 130 / 0.1);
		backdrop-filter: blur(6px) saturate(1.02);
		align-self: start;
		position: sticky;
		top: 1.25rem;
	}
	.d-brand { display: flex; gap: 0.7rem; align-items: center; text-decoration: none; color: inherit; }
	.d-brand-mark {
		display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 0.85rem;
		background: linear-gradient(135deg, var(--d-accent), var(--d-accent-2)); color: #fff; font-size: 1.1rem;
	}
	.d-brand strong { display: block; font-size: 0.98rem; }
	.d-brand small { display: block; font-size: 0.62rem; letter-spacing: 0.14em; color: var(--d-muted); }

	.d-nav { display: flex; flex-direction: column; gap: 0.25rem; }
	.d-nav button {
		display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.7rem;
		border: 0; border-radius: 0.75rem; background: transparent; color: var(--d-ink);
		font: inherit; font-size: 0.9rem; cursor: pointer; text-align: left;
	}
	.d-nav button svg { width: 1.05rem; height: 1.05rem; color: var(--d-muted); }
	.d-nav button:hover { background: rgb(154 123 212 / 0.1); }
	.d-nav button.active { background: linear-gradient(135deg, rgb(154 123 212 / 0.18), rgb(241 155 196 / 0.16)); color: var(--d-accent); font-weight: 500; }
	.d-nav button.active svg { color: var(--d-accent); }

	.d-usage { margin-top: auto; font-size: 0.78rem; color: var(--d-muted); }
	.d-usage-bar { height: 0.4rem; border-radius: 999px; background: rgb(120 96 160 / 0.14); overflow: hidden; }
	.d-usage-bar i { display: block; height: 100%; width: 0; border-radius: inherit; background: linear-gradient(90deg, var(--d-accent), var(--d-accent-2)); transition: width 0.3s; }
	.d-usage-bar i.warn { background: linear-gradient(90deg, #f0a35c, var(--d-danger)); }
	.d-usage p { margin: 0.45rem 0 0; line-height: 1.5; }
	.d-usage span { opacity: 0.75; }
	.d-back { font-size: 0.8rem; color: var(--d-muted); text-decoration: none; }
	.d-back:hover { color: var(--d-accent); }

	/* 主区 */
	.d-main { display: flex; flex-direction: column; gap: 0.9rem; min-width: 0; }
	.d-top {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
		padding: 0.85rem 1.1rem; border-radius: 1.2rem; background: var(--d-card);
		border: 1px solid var(--d-line); box-shadow: 0 0.8rem 2rem rgb(90 70 130 / 0.08); backdrop-filter: blur(5px) saturate(1.02);
	}
	.d-crumbs { display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; font-size: 0.95rem; }
	.d-crumbs button { border: 0; background: transparent; font: inherit; color: var(--d-muted); cursor: pointer; padding: 0.15rem 0.25rem; border-radius: 0.4rem; }
	.d-crumbs button:hover { color: var(--d-accent); background: rgb(154 123 212 / 0.1); }
	.d-crumbs button:last-child { color: var(--d-ink); font-weight: 500; }
	.d-crumb-sep { color: rgb(120 96 160 / 0.4); }
	.d-crumb-title { font-weight: 500; }

	.d-top-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
	.d-search input {
		width: 12rem; padding: 0.45rem 0.7rem; border-radius: 0.7rem; border: 1px solid var(--d-line);
		background: rgb(255 255 255 / 0.7); font: inherit; font-size: 0.85rem; color: inherit;
	}
	.d-search input:focus { outline: 2px solid rgb(154 123 212 / 0.35); outline-offset: 1px; }
	.d-sort { padding: 0.42rem 0.5rem; border-radius: 0.7rem; border: 1px solid var(--d-line); background: rgb(255 255 255 / 0.7); font: inherit; font-size: 0.82rem; color: inherit; }

	.d-btn {
		display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.45rem 0.8rem; border-radius: 0.7rem;
		border: 1px solid var(--d-line); background: rgb(255 255 255 / 0.8); color: var(--d-ink);
		font: inherit; font-size: 0.85rem; cursor: pointer; text-decoration: none; white-space: nowrap;
	}
	.d-btn:hover { border-color: rgb(154 123 212 / 0.5); color: var(--d-accent); }
	.d-btn-sm { padding: 0.3rem 0.55rem; font-size: 0.78rem; }
	.d-btn-primary { background: linear-gradient(135deg, var(--d-accent), var(--d-accent-2)); border: 0; color: #fff; font-weight: 500; }
	.d-btn-primary:hover { color: #fff; filter: brightness(1.04); }
	.d-btn-danger { color: var(--d-danger); border-color: rgb(217 99 111 / 0.35); }
	.d-btn-danger:hover { border-color: var(--d-danger); color: var(--d-danger); }

	/* 「选择」小药丸：默认就看得见，点了才进多选模式 */
	.d-pick {
		padding: 0.22rem 0.6rem; border-radius: 999px; border: 1px solid rgb(154 123 212 / 0.28);
		background: rgb(154 123 212 / 0.08); color: var(--d-accent);
		font: inherit; font-size: 0.74rem; line-height: 1.2; cursor: pointer; white-space: nowrap;
		transition: background 0.16s ease, border-color 0.16s ease, transform 0.12s ease;
	}
	.d-pick:hover { background: rgb(154 123 212 / 0.16); border-color: rgb(154 123 212 / 0.5); }
	.d-pick:active { transform: scale(0.94); }
	.d-row.pickable, .d-card.pickable { cursor: pointer; }
	.d-row.selected { background: rgb(154 123 212 / 0.09); }
	.d-card.selected { border-color: rgb(154 123 212 / 0.55); box-shadow: 0 0 0 2px rgb(154 123 212 / 0.18); }

	.d-icon-btn {
		display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 0.55rem;
		border: 1px solid transparent; background: transparent; color: var(--d-muted); font-size: 0.85rem; cursor: pointer;
	}
	.d-icon-btn:hover { background: rgb(154 123 212 / 0.12); color: var(--d-accent); border-color: rgb(154 123 212 / 0.25); }
	.d-icon-btn.on { color: #e8a33d; }

	.d-toolbar {
		display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; min-height: 2.2rem;
		padding: 0.4rem 0.75rem; font-size: 0.85rem; color: var(--d-muted);
		border-radius: 0.9rem; background: rgb(255 255 255 / 0.42); backdrop-filter: blur(12px);
		border: 1px solid rgb(255 255 255 / 0.35);
	}
	.d-check-all { display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; }
	.d-tool-text { opacity: 0.9; }
	.d-bulk { display: flex; gap: 0.4rem; flex-wrap: wrap; }

	.d-body {
		flex: 1; min-height: 20rem; padding: 0.4rem; border-radius: 1.2rem;
		background: var(--d-card); border: 1px solid var(--d-line); backdrop-filter: blur(5px) saturate(1.02);
		box-shadow: 0 0.8rem 2rem rgb(90 70 130 / 0.08);
	}
	.d-body.dragover { border-color: var(--d-accent); background: rgb(154 123 212 / 0.08); }

	/* ---------- 动效 ---------- */
	@keyframes d-fade-up { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
	@keyframes d-pop { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
	@keyframes d-fade { from { opacity: 0; } to { opacity: 1; } }
	@keyframes d-spin { to { transform: rotate(360deg); } }
	@keyframes d-shimmer { from { background-position: 180% 0; } to { background-position: -80% 0; } }
	@keyframes d-indeterminate {
		0% { transform: translateX(-100%) scaleX(0.35); }
		50% { transform: translateX(25%) scaleX(0.6); }
		100% { transform: translateX(110%) scaleX(0.35); }
	}

